            "mimeType": "application/json",
            "text": "{\"id\":\"newsletterForm\",\"steps\":[{\"fields\":[{\"constraints\":[{\"errorMessage\":\"Vul een geldig e-mailadres in\",\"parameters\":{\"flags\":[\"CASE_INSENSITIVE\"],\"regex\":\"^[a-zA-Z0-9._%+-]{1,60}@[a-zA-Z0-9.+-]+\\\\.[a-zA-Z]+$\"},\"type\":\"pattern\"},{\"errorMessage\":\"Vul een geldig e-mailadres in\",\"parameters\":{},\"type\":\"required\"}],\"description\":\"<p>Mis geen aanbieding en profiteer als eerste van grote acties!</p>\",\"dtoFields\":[\"email\"],\"label\":\"<p>Blijmakers in je mailbox?</p>\",\"name\":\"email\",\"placeholder\":\"Je e-mailadres\",\"readOnly\":false,\"tooltip\":\"&lt;p&gt;&lt;strong&gt;Wij gaan vertrouwelijk om met jouw gegevens&lt;/strong&gt;&lt;/p&gt;\\n&lt;p&gt;Door jouw e-mailadres in te vullen bevestig je dat je op de hoogte bent van ons Privacybeleid. Je kunt je altijd afmelden voor onze nieuwsbrieven via de afmeldlink in de nieuwsbrieven of door contact op te nemen met onze klantenservice. Als je jonger bent dan 16 jaar bevestig je dat je ouder of voogd ermee instemt dat je onze nieuwsbrieven ontvangt.&lt;/p&gt;\",\"type\":\"TEXT\"}],\"popUp\":false,\"prefilled\":false,\"title\":\"Maak een nieuwsbriefabonnement aan\"}],\"submitMethod\":\"POST\",\"successRedirectLink\":\"/newsletterSignup/confirm\"}"
