            "size": 34539,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"nl-NL\">\n<head>\n\t<title>\n\t\tJouw Winkelmand | Trekpleister</title>\n\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\"/>\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge, chrome=1\">\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n\t<meta name=\"turbolinks-cache-control\" content=\"no-cache\">\n\t<meta name=\"format-detection\" content=\"telephone=no\"/>\n\n\t<meta name=\"keywords\" content=\"Trekpleister\">\n<meta name=\"description\" content=\"Shop online bij voordelige buurtdrogist Trekpleister. Waar kunnen we je blij mee maken?\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<link rel=\"shortcut icon\" type=\"image/x-icon\" media=\"all\" href=\"/_ui/addons/kvstorefrontaddon/responsive/common/icons/kvtp/hipfavicon.png\" />\n\t\t<link rel=\"preload\" as=\"font\" type=\"font/woff2\" crossorigin href=\"/_ui/responsive/common/dist/kv/resources/fonts/trekpleister/OpenSans-Regular.woff2\">\n<link rel=\"preload\" as=\"font\" type=\"font/woff2\" crossorigin href=\"/_ui/responsive/common/dist/kv/resources/fonts/kruidvat-icons.woff2?v=6bd3086a8b90f9661d65d37e5fb53866\">\n<style>\n    @font-face {\n        font-family: \"kruidvat-icons\";\n        src: url(\"/_ui/responsive/common/dist/kv/resources/fonts/kruidvat-icons.woff2?v=6bd3086a8b90f9661d65d37e5fb53866\") format(\"woff2\");\n        font-weight: normal;\n        font-style: normal;\n        font-display: block;\n    }\n</style>\n<script>\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({originalLocation: document.location.protocol + '//' + document.location.hostname + document.location.pathname + document.location.search});\n    </script>\n<!-- Google Tag Manager -->\n    <link rel=\"preconnect\" href=\"https://www.googletagmanager.com/\" crossorigin>\n    <link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com/\">\n\n    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\n    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\n    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n    })(window,document,'script','dataLayer','GTM-N5FNGLL');\n    </script>\n    <!-- End Google Tag Manager -->\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<script type=\"text/javascript\">\n        // Duration in milliseconds to wait while the Kameleoon application file is loaded\n        var kameleoonLoadingTimeout = 1000;\n\n        window.kameleoonQueue = window.kameleoonQueue || [];\n        window.kameleoonStartLoadTime = new Date().getTime();\n        if (!document.getElementById(\"kameleoonLoadingStyleSheet\") && !window.kameleoonDisplayPageTimeOut) {\n            var kameleoonS = document.getElementsByTagName(\"script\")[0];\n            var kameleoonCc = \"* { visibility: hidden !important; background-image: none !important; }\";\n            var kameleoonStn = document.createElement(\"style\");\n            kameleoonStn.type = \"text/css\";\n            kameleoonStn.id = \"kameleoonLoadingStyleSheet\";\n            if (kameleoonStn.styleSheet) {\n                kameleoonStn.styleSheet.cssText = kameleoonCc;\n            } else {\n                kameleoonStn.appendChild(document.createTextNode(kameleoonCc));\n            }\n            kameleoonS.parentNode.insertBefore(kameleoonStn, kameleoonS);\n            window.kameleoonDisplayPage = function (fromEngine) {\n                if (!fromEngine) {\n                    window.kameleoonTimeout = true;\n                }\n                if (kameleoonStn.parentNode) {\n                    kameleoonStn.parentNode.removeChild(kameleoonStn);\n                }\n            };\n            window.kameleoonDisplayPageTimeOut = window.setTimeout(window.kameleoonDisplayPage, kameleoonLoadingTimeout);\n        }\n    </script>\n    <script type=\"text/javascript\" src=\"//29ggr5mqlk.kameleoon.io/engine.js\" async=\"true\" fetchpriority=\"high\"></script>\n<link rel=\"preload\" as=\"style\" href=\"/_ui/responsive/common/dist/kv/styles/shared.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n        <link rel=\"stylesheet\" href=\"/_ui/responsive/common/dist/kv/styles/shared.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n\n        <link rel=\"preload\" as=\"style\" href=\"/_ui/responsive/common/dist/kv/styles/app.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n        <link rel=\"stylesheet\" href=\"/_ui/responsive/common/dist/kv/styles/app.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n        <link rel=\"preload\" as=\"style\" href=\"/_ui/responsive/common/dist/kv/js/app-desktop.css?v=6bd3086a8b90f9661d65d37e5fb53866\" media=\"(min-width: 960px)\">\n        <link rel=\"stylesheet\" href=\"/_ui/responsive/common/dist/kv/js/app-desktop.css?v=6bd3086a8b90f9661d65d37e5fb53866\" media=\"(min-width: 960px)\">\n    <link rel=\"preload\" as=\"style\" href=\"/_ui/responsive/common/dist/kv/styles/theme-core.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n    <link rel=\"stylesheet\" href=\"/_ui/responsive/common/dist/kv/styles/theme-core.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n<link rel=\"preload\" as=\"style\" href=\"/_ui/responsive/common/dist/kv/styles/theme-trekpleister-hip.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n<link rel=\"stylesheet\" href=\"/_ui/responsive/common/dist/kv/styles/theme-trekpleister-hip.css?v=6bd3086a8b90f9661d65d37e5fb53866\">\n\n<link rel=\"modulepreload\" as=\"script\" href=\"/_ui/responsive/common/dist/kv/js/initialize.js?v=6bd3086a8b90f9661d65d37e5fb53866\" />\n<link rel=\"modulepreload\" as=\"script\" href=\"/_ui/responsive/common/dist/kv/js/commonComponents.js?v=6bd3086a8b90f9661d65d37e5fb53866\" />\n\n<script nomodule src=\"/_ui/responsive/common/dist/kv/js/polyfills.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n\n<script type=\"module\" src=\"/_ui/responsive/common/dist/kv/js/initialize.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n<script type=\"module\" src=\"/_ui/responsive/common/dist/kv/js/commonComponents.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n\n<script nomodule defer src=\"/_ui/responsive/common/dist/kv/js/initialize-legacy.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n<script nomodule defer src=\"/_ui/responsive/common/dist/kv/js/commonComponents-legacy.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n\n<link rel=\"modulepreload\" as=\"script\" href=\"/_ui/responsive/common/dist/kv/js/notCommonComponents.js?v=6bd3086a8b90f9661d65d37e5fb53866\" />\n    <script type=\"module\" src=\"/_ui/responsive/common/dist/kv/js/notCommonComponents.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n    <script nomodule defer src=\"/_ui/responsive/common/dist/kv/js/notCommonComponents-legacy.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n<link rel=\"preload\" as=\"script\" href=\"/_ui/responsive/common/dist/kv/js/sharedAssets.js?v=6bd3086a8b90f9661d65d37e5fb53866\"/>\n<script defer src=\"/_ui/responsive/common/dist/kv/js/sharedAssets.js?v=6bd3086a8b90f9661d65d37e5fb53866\"></script>\n\n<script>\n    window.e2_assets_urls = {\n        'acehub': '/_ui/responsive/common/dist/kv/js/acehub.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'AdyenCheckout': '/_ui/responsive/common/dist/kv/js/AdyenCheckout.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'barcode': '/_ui/responsive/common/dist/kv/js/barcode.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'MarkerClusterer': '/_ui/responsive/common/dist/kv/js/MarkerClusterer.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'PerfectScrollbar': '/_ui/responsive/common/dist/kv/js/perfectScrollbar.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'Swiper': '/_ui/responsive/common/dist/kv/js/Swiper.js?v=6bd3086a8b90f9661d65d37e5fb53866',\n        'XRegExp': '/_ui/responsive/common/dist/kv/js/XRegExp.js?v=6bd3086a8b90f9661d65d37e5fb53866'\n    }\n</script>\n<link rel=\"preload\" as=\"script\" href=\"https://cdn.cookielaw.org/scripttemplates/otSDKStub.js?v=6bd3086a8b90f9661d65d37e5fb53866\" />\n    <script\n        id=\"onetrust-script\"\n        data-src=\"https://cdn.cookielaw.org/scripttemplates/otSDKStub.js?v=6bd3086a8b90f9661d65d37e5fb53866\"\n        data-document-language=\"true\"\n        data-domain-script=\"96cead1f-6a0d-4f9a-a2f3-f78cf7f44058\"\n        data-external-domains=\".trekpleister.nl\"\n    ></script>\n</head>\n\n<body class=\"page-cartPage pageType-ContentPage template-pages-cart-cartPage pageLabel-cart smartedit-page-uid-cartPage smartedit-page-uuid-eyJpdGVtSWQiOiJjYXJ0UGFnZSIsImNhdGFsb2dJZCI6Imt2dHBDb250ZW50Q2F0YWxvZyIsImNhdGFsb2dWZXJzaW9uIjoiT25saW5lIn0= smartedit-catalog-version-uuid-kvtpContentCatalog/Online trekpleister  --trekpleister-hip language-nl\">\n    <e2-app\n        customer-status-retry=\"3\"\n        customer-status-delay=\"1000\"\n        available-languages='[\"nl\"]'\n        country=\"NL\"\n        language=\"nl\"\n        site=\"kvtp\"\n        image-placeholder-path=\"/_ui/addons/kvstorefrontaddon/responsive/common/images/missing_product_nl_300x300.png\"\n        br-catalog-name=\"\"\n        page-category-id=\"\"\n        breadcrumbs-for-analytics=\"Home > breadcrumb.cart\"\n        \n        data-page-type=\"ContentPage\"\n        data-page-type-override=\"\"\n\t\t\n    ></e2-app>\n\n    <!-- Google Tag Manager (noscript) -->\n    <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-N5FNGLL\"\n    height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n    <!-- End Google Tag Manager (noscript) -->\n<div class=\"e2-page e2-page--reduced\">\n        <header class=\"e2-header e2-page__header e2-page__header--reduced\">\n    \n<div id='8822814049340' class='ajax-loaded-component' style='display:none;'>&nbsp;</div>\n<script>\nfunction r_8822814049340(f){/in/.test(document.readyState)?setTimeout(r_8822814049340,9,f):f()}\nr_8822814049340(function(){\nvar xhr = new XMLHttpRequest();\nxhr.open('GET', '/view/JspIncludeComponentController?componentUid=TimeMachineLabel');\nxhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');\nxhr.setRequestHeader('Accept', 'text/html, */*; q=0.01');\nxhr.onload = function () {\nif (xhr.status === 200) {\nvar element = document.getElementById('8822814049340');\nif (!element) { return; }\nelement.innerHTML = xhr.response;\nelement.style.display = '';\n}};\nxhr.send();\n});\n</script>\n<div class=\"e2-header__wrapper\">\n        <div class=\"e2-header__row\">\n            <div class=\"e2-header__fragment\">\n                <div class=\"yCmsComponent e2-header__logo\">\n<div class=\"header-logo\">\n    <div class=\"banner__component simple-banner\">\n  <e2-impression-tracker\n\t\t\t\ttrack-clicks\n\t\t\t\tclick-handler=\"handleNavigationEvent\"\n        data-event=\"header_logo\"\n\t\t\t>\n        <a href=\"/\" class=\"SiteLogoEvent_Class\">\n          <img title=\"TP HIP Main Logo\" alt=\"TP HIP Main Logo\" src=\"/medias/sys_master/images/h1c/h7b/30828722552862/TP-hip-main-logo/TP-hip-main-logo.png\"></a>\n      </e2-impression-tracker>\n    </div></div>\n\n<a class=\"e2-logo-mobile\" href=\"/\">\n    <i class=\"e2-logo-mobile__icon\">\n        <span class=\"c-sticky-footer__item-kv-icon\"></span>\n    </i>\n    Home</a></div></div>\n\n            <div class=\"e2-header__fragment e2-header__fragment--inline e2-header__fragment--col-half\">\n                <div class=\"yCmsContentSlot e2-header__component-cart\">\n<div class=\"yCmsComponent e2-header__cart\">\n<e2-mini-cart-popover\n    cart-link=\"/cart\"\n    discount-price-label-map=\"{&#034;product.pricetag.from.label&#034;:&#034;van&#034;,&#034;product.pricetag.from.other.store&#034;:&#034;Elders&#034;,&#034;product.pricetag.from.suggested.manufacturer&#034;:&#034;Adviesprijs *&#034;,&#034;product.pricetag.from.suggested.manufacturer_description&#034;:&#034;* aanbevolen verkoopprijs leverancier&#034;}\"\n    product-added-text=\"Product(en) succesvol toegevoegd aan winkelmand\"\n    go-to-cart-text=\"Bekijk winkelmand\"\n    digital-loyalty-cart-msg=\"Je voucher code(s) zal binnen een paar uur per mail naar je worden verzonden.\"\n    quantity-label=\"Aantal\"\n    max-product-text=\"Maximale bestelhoeveelheid voor product is bereikt\"\n    min-product-text=\"De minimale bestelhoeveelheid is {0}\"\n    low-stock-text=\"Artikel niet toegevoegd aan winkelmand omdat het artikel niet meer op voorraad is.\"\n    default-info-message=\"Gratis afhalen in een Trekpleister winkel.\"\n    marketplace-info-message=\"minicart.message.marketplace\"\n    points-label=\"Punten\"\n    reduced\n    header-message=\"Product(en) succesvol toegevoegd aan winkelmand\"\n    has-old-price-template\n    show-warning-message\n    \n    fastlane-label=\"minicart.fastlane.label\"\n    fastlane-description=\"Bestaat je winkelmandje volledig uit `morgen in huis` producten dan kan je winkelmand morgen bezorgd worden!\"\n    fastlane-link-text=\"Bekijk alle producten\"\n    fastlane-link-url=\"/search?q=%3A%3Afastlane%3Atrue\"\n    aria-label=\"minicart.aria.label\"\n>\n<e2-header-cart\n            v-slot=\"target\"\n            class=\"header-cart\"\n            href=\"/cart\"\n            data-gtm-href=\"/cart\"\n            empty-link=\"true\"\n            points-label='Punten'\n            discount-label='bespaard'\n            product-label='producten'\n            total-price-label='Totaalprijs'\n            reduced\n        >\n            <div v-slot=\"caption\" class=\"minicart__caption\" data-gtm-href=\"/cart\">Winkelmand</div>\n        </e2-header-cart>\n    </e2-mini-cart-popover>\n</div></div></div>\n        </div>\n    </div>\n</header>\n<e2-page-scroll elementSticky=\".e2-header\" elementPage=\".e2-page\" prefix=\"e2-page\"></e2-page-scroll>\n<main class=\"e2-main\">\n            <div class=\"e2-page__background\">\n                    <div class=\"e2-page__container-fluid-mobile\">\n                        </div>\n                </div>\n            <div class=\"container-new container-new--cart\">\n        <div class=\"breadcrumbs__wrapper breadcrumbs__wrapper--checkout\" tabindex=\"0\" role=\"list\" aria-label=\"checkout.breadcrumbs.title\">\n        <nav aria-label=\"breadcrumb\">\n    <ol class=\"breadcrumbs-holder breadcrumbs-holder--checkout\" data-name=\"cartPage\" data-location=\"checkout\">\n        <e2-breadcrumbs-item\n        name=\"cartPage\"\n        is-numeric-icon\n        item-label=\"Mandje\"\n        item-label-mobile=\"\"\n        url=\"/cart\"\n        stepNumber=\"1\"\n        current-step-number=\"1\"\n        \n        current-step-label=\"checkout.breadcrumbs.current.step\"\n        other-step-label=\"checkout.breadcrumbs.other.step\"\n        step-number-label=\"checkout.breadcrumbs.firstStep\"\n    >\n    </e2-breadcrumbs-item>\n\n<e2-breadcrumbs-item\n        name=\"deliveryAddress\"\n        is-numeric-icon\n        item-label=\"Gegevens\"\n        item-label-mobile=\"\"\n        url=\"\"\n        stepNumber=\"2\"\n        current-step-number=\"1\"\n        dataRequired\n        current-step-label=\"checkout.breadcrumbs.current.step\"\n        other-step-label=\"checkout.breadcrumbs.other.step\"\n        step-number-label=\"checkout.breadcrumbs.secondStep\"\n    >\n    </e2-breadcrumbs-item>\n\n<e2-breadcrumbs-item\n        name=\"\"\n        is-numeric-icon\n        item-label=\"Bezorg\"\n        item-label-mobile=\"\"\n        url=\"\"\n        stepNumber=\"3\"\n        current-step-number=\"1\"\n        disabled\n        current-step-label=\"checkout.breadcrumbs.current.step\"\n        other-step-label=\"checkout.breadcrumbs.other.step\"\n        step-number-label=\"checkout.breadcrumbs.thirdStep\"\n    >\n    </e2-breadcrumbs-item>\n\n<e2-breadcrumbs-item\n        name=\"\"\n        is-numeric-icon\n        item-label=\"Betaal\"\n        item-label-mobile=\"\"\n        url=\"\"\n        stepNumber=\"4\"\n        current-step-number=\"1\"\n        disabled\n        current-step-label=\"checkout.breadcrumbs.current.step\"\n        other-step-label=\"checkout.breadcrumbs.other.step\"\n        step-number-label=\"checkout.breadcrumbs.fourthStep\"\n    >\n    </e2-breadcrumbs-item>\n\n</ol>\n</nav></div>\n<h1\n        class=\"heading \n        m-bottom-medium   \"\n    >\n        <span class=\"heading__text\">\n            <span class=\"heading__word\">Jouw</span>\n            <span class=\"heading__word\">Winkelmand</span></span>\n        </h1>\n<e2-when-defined name=\"cart.isEmpty\">\n                <div class=\"cart-message cart-message--empty\">\n                    <e2-paragraph class=\"content\">\n    <p>Je winkelmandje is nog leeg</p></e2-paragraph>\n</div>\n            </e2-when-defined>\n        <div class=\"checkout-delivery-message\">\n        <h5 class=\"h5 checkout-delivery-message__title\"><i class=\"icon icon-greentick\"></i> Bestelling gratis afhalen in alle winkels, altijd een winkel in de buurt</h5>\n    </div>\n<e2-superdeal\n            data-id=\"superdealComponentContainer\"\n            data-label-header=\"cart.page.superdeal.header\"\n            data-label-add-to-cart=\"Voeg toe\"\n            data-variation-type=\"select\"\n        ></e2-superdeal>\n    <e2-when-defined name=\"cart.isEmpty\">\n            <div class=\"cart-button-empty m-top_bottom-medium m-top-large--mobile m-bottom-large--mobile\">\n                <e2-button\n                    button-label=\"Verder winkelen\"\n                    url=\"/search?q=weleda&text=weleda&searchType=manual\"\n                    size=\"big\"\n                    full-width class=\"cart-actions__btn cart-actions__btn--continue\">\n                </e2-button>\n            </div>\n        </e2-when-defined>\n        <e2-when-defined not name=\"cart.isEmpty\">\n            <div class=\"yCmsContentSlot top-content-slot m-top-medium m-top-large--mobile\">\n<div class=\"cart-actions__wrapper\">\n    <div>\n    <e2-connected-message\n        filter=\"%source% !== 'OTC_VALIDATION' && %source% !== 'DELIVERY_ADDRESS_VALIDATION' && %source% !== 'ADDRESS_CONSISTENCY_VALIDATION' && %source% !== 'FREE_DELIVERY' && #data.checkoutBlocked# \"\n        bold\n        store-name=\"cart\"\n        field-name=\"data.messages\"\n        show-button-filter='{\"sourceAndType\": [{\"source\": \"CART_BLOCKING\", \"type\": \"INFO\" }] }'\n        prev\n        label=\"Verder winkelen\"\n    >\n    </e2-connected-message>\n</div>\n\n<div class=\"cart-actions\">\n        <e2-button\n            button-label='Verder winkelen'\n            url=\"/search?q=weleda&text=weleda&searchType=manual\"\n            class-modifier=\"button--prev\"\n            class=\"cart-actions__btn cart-actions__btn--back\"\n            size\n        ></e2-button>\n\n        <e2-action-button full-width\n            button-label='Verder naar bestellen'\n            action-type=\"CART.CHECK_REDIRECT\"\n            success-redirect-url=\"/cart/checkout\"\n            failure-redirect-url=\"/cart\"\n            size=\"big\"\n            class=\"cart-actions__btn cart-actions__btn--checkout\"\n            disabled-if=\"cart.data.checkoutBlocked\"\n            \n        ></e2-action-button>\n    </div>\n</div>\n</div></e2-when-defined>\n\n        <e2-connected-message bold\n            store-name=\"cart\"\n            field-name=\"data.messages\"\n            filter=\"\n                %source% !== 'OTC_VALIDATION'\n                && %source% !== 'FREE_DELIVERY'\n                && %source% !== 'DELIVERY_ADDRESS_VALIDATION'\n                && %source% !== 'ADDRESS_CONSISTENCY_VALIDATION'\n                && (#isEmpty# || !#data.checkoutBlocked#)\n            \"\n        ></e2-connected-message>\n\n        <e2-when-defined not name=\"cart.isEmpty\">\n            <h3 class=\"product-summary__main-title\">Jouw producten</h3>\n            <e2-product-summary\n    delete-button-label=\"Verwijder\"\n    product-label= \"Jouw producten\"\n    quantity-label= \"Aantal\"\n    total-price-label= \"Totaalprijs\"\n    you-save-label= \"Je bespaart\"\n     stock-reservation-enabled\n    disabled-features='[]'\n    fast-lane-text=\"morgen in huis\"\n    select-scroll-theme-class=\"advanced-scroll\"\n    select-scroll-size=\"14\"\n    in-stock-label=\"Voeg toe\"\n        freemium-title=\"Voeg je gratis product toe\"\n        freemium-free-item-label=\"GRATIS\"\n        freemium-out-of-stock-label=\"Niet op voorraad\"\n></e2-product-summary>\n<e2-incentive-messages url=\"/search?q=weleda&text=weleda&searchType=manual\" button-text=\"Verder winkelen\"></e2-incentive-messages>\n<div class=\"row no-gutters\">\n                <div class=\"col-12 col-md-8\">\n                    </div>\n                <div class=\"yCmsContentSlot col-12 col-md-4\">\n<script id=\"cartPromotionSectionTemplate\" type=\"text/x-jquery-tmpl\">\n    {{if appliedOrderPromotions.length > 0}}\n        <div class=\"cartproline\">\n             basket.received.promotions\n             {{each(index, appliedOrderPromotion) appliedOrderPromotions}}\n                 <div class=\"promotion\">{{= appliedOrderPromotion.description}}</div>\n             {{/each}}\n             </div>\n    {{/if}}\n</script>\n\n<div id=\"ajaxCartPromotionSection\">\n</div>\n\n\n<script id=\"cartPotentialPromotionSectionTemplate\" type=\"text/x-jquery-tmpl\">\n    {{if potentialOrderPromotions.length > 0}}\n        <div class=\"cartpotproline\">\n             basket.potential.promotions\n             {{each(index, potentialOrderPromotion) potentialOrderPromotions}}\n                 <div class=\"promotion\">{{= potentialOrderPromotion.description}}</div>\n             {{/each}}\n             </div>\n    {{/if}}\n</script>\n\n<div id=\"ajaxCartPotentialPromotionSection\">\n</div>\n\n\n</div></div>\n            <div class=\"row no-gutters\">\n                <div class=\"yCmsContentSlot col-12 col-md-8\">\n</div><div class=\"col-12 col-md-4\"></div>\n          