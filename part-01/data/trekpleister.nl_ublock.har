ion) potentialOrderPromotions}}\n                 <div class=\"promotion\">{{= potentialOrderPromotion.description}}</div>\n             {{/each}}\n             </div>\n    {{/if}}\n</script>\n\n<div id=\"ajaxCartPotentialPromotionSection\">\n</div>\n\n\n<div class=\"usp-block\">\n    <ul class=\"usp-block__list\">\n        <li class=\"yCmsComponent usp-block__item\">\n<span class=\"yCmsComponent icon-text__icon\">\n<img class=\"lazyload\" data-src=\"/medias/sys_master/images/he7/h19/28379719073822/check-mark_green/check-mark-green.svg\" alt=\"\"/>\n    </span><span class=\"icon-text__text\">Bestelling gratis afhalen in alle winkels</span></li><li class=\"yCmsComponent usp-block__item\">\n<span class=\"yCmsComponent icon-text__icon\">\n<img class=\"lazyload\" data-src=\"/medias/sys_master/images/he7/h19/28379719073822/check-mark_green/check-mark-green.svg\" alt=\"\"/>\n    </span><span class=\"icon-text__text\">Gratis thuisbezorgd bij een bestelling vanaf 50 euro</span></li><li class=\"yCmsComponent usp-block__item\">\n<span class=\"yCmsComponent icon-text__icon\">\n<img class=\"lazyload\" data-src=\"/medias/sys_master/images/he7/h19/28379719073822/check-mark_green/check-mark-green.svg\" alt=\"\"/>\n    </span><span class=\"icon-text__text\">Gratis retourneren binnen 30 dagen</span></li><li class=\"yCmsComponent usp-block__item\">\n<span class=\"yCmsComponent icon-text__icon\">\n<img class=\"lazyload\" data-src=\"/medias/sys_master/images/he7/h19/28379719073822/check-mark_green/check-mark-green.svg\" alt=\"\"/>\n    </span><span class=\"icon-text__text\">Werkdagen voor 22:00 besteld morgen thuisbezorgd</span></li></ul>\n</div><e2-paragraph class=\"content\">\n    <div class=\"checkout-delivery-and-order-information__payment-logos\">\n                                   <img src=\"_ui/addons/kvstorefrontaddon/responsive/common/images/payment-methods/ideal-wero.svg\" alt=\"iDEAL | Wero logo\">\n                                   <img src=\"_ui/addons/kvstorefrontaddon/responsive/common/images/payment-methods/mastercard.svg\" alt=\"Mastercard\">\n                                   <img src=\"_ui/addons/kvstorefrontaddon/responsive/common/images/payment-methods/visa.svg\" alt=\"Visa\">\n                                   <img src=\"_ui/addons/kvstorefrontaddon/responsive/common/images/payment-methods/thuiswinkel-waarborg.svg\" alt=\"Thuiswinkel Waarborg\">\n                                   </div></e2-paragraph>\n<e2-paragraph class=\"content\">\n    <h6 class=\"text text--16 text--success\">\n                    <font color=\"#458b00\"><strong>Je oude apparaat retour</strong></font>\n                    <e2-tooltip show-on-hover >\n                        <i tabindex=\"1\" class=\"icon icon-info tooltip-icon\" v-slot=\"target\"></i>\n                        <div v-slot=\"content\">\n                            <strong>Je oude apparaat retour</strong>\n                            <p>Bij aankoop van een nieuw (elektrisch) huishoudelijk apparaat op onze website kun je je oude,\n                                soortgelijke apparaat inleveren in één van onze Kruidvat winkels. Neem je orderbevestiging mee.\n                                Daarnaast kun je je apparaat inleveren bij de kringloop of het inzamelpunt van je gemeente.\n                                Bovenstaande is niet van toepassing voor aankopen via een partner, raadpleeg betreffend product van de partner voor informatie hierover.\n                            </p>\n                        </div>\n                    </e2-tooltip>\n                </h6></e2-paragraph>\n</div><e2-paragraph class=\"content\">\n    <div id=\"swogo-bundle-0\" class=\"swogo-box\"></div></e2-paragraph>\n</div>\n<!-- peerius to be deleted -->\n<e2-store-data-setter\n    value='{\"text\":\"Je bent afgemeld voor de Trekpleister Baby Voordeelclub\",\"backgroundColor\":\"#458B00\",\"textColor\":\"#FFFFFF\",\"name\":\"successfulUnsubscribeMessage\"}'\n    action-type=\"enhancedAuth.SET_MESSAGE\"\n></e2-store-data-setter>\n\n<e2-store-data-setter\n    value='{\"text\":\"baby.club.child.added.message\",\"backgroundColor\":\"#458B00\",\"textColor\":\"#ffffff\",\"name\":\"childAddedMessage\"}'\n    action-type=\"enhancedAuth.SET_MESSAGE\"\n></e2-store-data-setter>\n<e2-store-data-setter\n    value='{\"text\":\"Je bent ingelogd\",\"backgroundColor\":\"#458B00\",\"textColor\":\"#FFFFFF\",\"name\":\"successfulLoginMessage\"}'\n    action-type=\"enhancedAuth.SET_MESSAGE\"\n></e2-store-data-setter>\n\n<e2-store-data-setter\n    value='{\"text\":\"baby.club.child.added.message\",\"backgroundColor\":\"#458B00\",\"textColor\":\"#ffffff\",\"name\":\"childAddedMessage\"}'\n    action-type=\"enhancedAuth.SET_MESSAGE\"\n></e2-store-data-setter>\n<e2-trigger-meta\n    hidden\n    \n    destination-success-url=\"\"\n    trigger-type=\"\"\n    trigger-uid=\"\"\n></e2-trigger-meta>\n\n<e2-store-data-setter\n    value=\"9\"\n    action-type=\"enhancedAuth.SET_MONTH_IN_PAST\"\n></e2-store-data-setter>\n</main>\n\n        <footer class=\"e2-footer e2-footer--reduced\">\n    <div class=\"yCmsContentSlot e2-footer__customer-service\">\n<div class=\"yCmsComponent e2-customer-service\">\n<e2-impression-tracker\n            track-clicks\n            click-handler=\"handleNavigationEvent\"\n            data-event=\"header_link\"\n            data-text=\"Klantenservice\"\n        >\n            <e2-link class=\"header__link\" href=\"https://service.trekpleister.nl/\" target=\"\" gtm-event=\"\" gtm-label=\"\">\n                        <span>\n                            <span class=\"yCmsComponent\">\n<i class=\"header__link-icon header__link-icon--customer-services\"></i>\n    </span>Klantenservice</span>\n                    </e2-link>\n                </e2-impression-tracker>\n        </div></div><div>\n    <a class=\"bottom-banner__wrapper\" href=\"/trekpleister/b/TREKPL\"><e2-impression-tracker\n            track-clicks\n            click-handler=\"handleFooterLink\"\n            data-event=\"footer_logo\"\n            >\n        <div\n            class=\"bottom-banner \"\n            \n        >\n            <div class=\"bottom-banner__logo\">\n                <img class=\"lazyload bottom-banner__embed\"\n                    alt=\"TP HIP Footer Logo\"\n                    data-src=\"/medias/sys_master/images/h43/h82/30828722323486/TP-hip-footer-logo/TP-hip-footer-logo.svg\">\n            </div>\n            <h3 class=\"bottom-banner__heading\">waar kunnen we je blij mee maken?</h3>\n        </div>\n    </e2-impression-tracker></a>\n        </div><e2-scroll-top\n        class=\"scroll-top__wrapper\"\n        back-to-top-button-label=\"Terug naar boven\"\n    >\n    </e2-scroll-top>\n<div id=\"privacy_cookie_blackbar_wrapper\"\n     data-cookie-url=\"https://www.kruidvat.nl/cookies\"\n     data-privacy-policy-url=\"https://www.kruidvat.nl/privacystatement\">\n</div>\n</footer>\n</div>\n\n    <e2-dialog name=\"popup-external\" addClass=\"dialog--popup-external\" close-bg-click is-connected no-scroll></e2-dialog>\n    <e2-dialog name=\"enhanced-auth-popup\" addClass=\"dialog--enhanced-auth-popup\" btn-close no-scroll>\n        <template>\n            <div slot=\"content\" class=\"enhanced-auth\">\n                <picture>\n    <source data-srcset=\"/_ui/responsive/common/dist/kv/images/Kruidvat-logo.webp\" type=\"image/webp\">\n    <img class=\"lazyload enhanced-auth__logo\"\n        data-src=\"/_ui/responsive/common/dist/kv/images/Kruidvat-logo.svg\" \n        alt=\"Kruidvat logo\"\n    />\n</picture><e2-enhanced-auth></e2-enhanced-auth>\n            </div>\n        </template>\n    </e2-dialog>\n    <e2-connected-message\n        type=\"custom\"\n        store-name=\"enhancedAuth\"\n        field-name=\"messages\"\n        css-modifier=\"snackbar\"\n        filter=\"%name% === #showMessage#\"\n        hide-icon\n        close-action-type=\"enhancedAuth.SET_MESSAGE_STATE\"\n        data-state=\"hiding\"\n    ></e2-connected-message>\n\n    <e2-side-panel\n    theme=\"iframe\"\n    open-if=\"iframe-panel\"\n    close-button-aria-label=\"Sluit\"\n>\n    <template>\n        <div data-id=\"template-content\">\n            <e2-action-button\n                v-slot=\"close-btn\"\n                class=\"side-panel__close-button\"\n                class-modifier=\"button--side-panel-close-big button--black\"\n                action-type=\"UI.HIDE_SIDEBAR\"\n                icon-element=\"icon icon-error\"\n                size=\"small\"\n                no-arrow\n            >\n            </e2-action-button>\n            <e2-iframe-content sidebar-id=\"iframe-panel\"></e2-iframe-content>\n        </div>\n    </template>\n</e2-side-panel><e2-light-popup id=\"check-date-of-birth-terms\" theme=\"dialog\" cssClass=\"light-popup--promo\">\n  <e2-simple-html name=\"ui.lightPopupContent\" class=\"baby-box-terms-conditon-container\"></e2-simple-html>\n</e2-light-popup><e2-medical-dialog\n    name=\"medical\"\n    is-connected\n    scroll-classes=\"advanced-scroll\"\n    scroll-size=\"14\"\n    class=\"medical-dialog medical-dialog--bluish\"\n    addClass=\"dialog--popup dialog--popup-medical dialog--bluish\"\n    btn-success=\"Ja\"\n    btn-cancel=\"Nee\"\n    class-success=\"full-width\"\n    class-cancel=\"black button--full-width\"\n    buttons-size=\"normal\"\n    close-bg-click\n    otc-title=\"Let op\"\n    otc-subtitle=\"Lees onderstaande\"\n    btn-close\n    otc-message=\"Lees voor gebruik de bijsluiter.<br>Let op: Geneesmiddelen verkopen we niet aan personen onder 16 jaar. <br>Het kan voorkomen dat de bezorger om je legitimatie vraagt.<br><br>Wil je meer informatie over dit geneesmiddel?\"\n    hidden\n>\n    <div slot=\"otc-message\">Lees voor gebruik de bijsluiter.<br>Let op: Geneesmiddelen verkopen we niet aan personen onder 16 jaar. <br>Het kan voorkomen dat de bezorger om je legitimatie vraagt.<br><br>Wil je meer informatie over dit geneesmiddel?</div>\n</e2-medical-dialog>\n<form name=\"accessibilityForm\">