                <div class=\"main-navigation__leaf\">\n        <e2-impression-tracker\n            track-clicks\n            click-handler=\"handleMainMenuElementsTracking\"\n            data-event-name=\"main_menu_manual\"\n            data-event-type=\"navigation\"\n            data-click-text=\"Winkels\"\n        >\n            <a class=\"main-navigation__link\"\n            href=\"/winkelzoeker\">\n            <div class=\"main-navigation__link-text\">\n                Winkels</div>\n            </a>\n    </e2-impression-tracker>\n    </div>\n<div class=\"main-navigation__leaf\">\n        <e2-impression-tracker\n            track-clicks\n            click-handler=\"handleMainMenuElementsTracking\"\n            data-event-name=\"main_menu_manual\"\n            data-event-type=\"navigation\"\n            data-click-text=\"Over Trekpleister\"\n        >\n            <a class=\"main-navigation__link\"\n            href=\"/overtrekpleister\">\n            <div class=\"main-navigation__link-text\">\n                Over Trekpleister</div>\n            </a>\n    </e2-impression-tracker>\n    </div>\n<div class=\"main-navigation__leaf\">\n        <e2-impression-tracker\n            track-clicks\n            click-handler=\"handleMainMenuElementsTracking\"\n            data-event-name=\"main_menu_manual\"\n            data-event-type=\"navigation\"\n            data-click-text=\"Klantenservice\"\n        >\n            <e2-action-button\n                    url=\"/service\"\n                    no-arrow\n                    action-type=\"UI.SHOW_HISTORY_SIDEBAR\"\n                    data-sidebar-id=\"nice\"\n                    data-back-button=\"true\"\n                    data-page-id=\"customerServiceHomePage\"\n                    class-modifier=\"button--menu-link\"\n                    button-label=\"Klantenservice\"\n                    s-disabled-redirect\n                    size=\"\"\n                >\n                </e2-action-button>\n            </e2-impression-tracker>\n    </div>\n</div>\n                    </div>\n                </nav>\n            </template>\n        </e2-side-panel>\n    </div><div class=\"yCmsContentSlot e2-header__component-lang\">\n</div></div>\n\n            </div>\n\n            <div class=\"e2-header__fragment e2-header__fragment--inline e2-header__fragment--col-half\">\n                <div class=\"yCmsContentSlot e2-header__component-login\">\n<div class=\"yCmsComponent e2-header__account\">\n<e2-when-defined not name=\"user.profile.firstName\">\n    <e2-popover open-on-target-click auto-focus-id=\"username-input\" show-header\n                    focus-back=\"header-login__link\" \n                    close-button-text=\"Sluit\"\n                    header-title=\"Inloggen\"\n                    aria-label='Inloggen'\n                    >\n        <div v-slot=\"content\" class=\"e2-account-menu\">\n            <e2-log-in-form\n                    class=\"log-in-form log-in-form--simple\"\n                    form-location=\"header\"\n                    email-label=\"Je e-mailadres\"\n                    email-placeholder=\"Je e-mailadres\"\n                    account-login-page-password-show-label=\"Toon wachtwoord\"\n                    account-login-page-password-hide-label=\"Verberg wachtwoord\"\n                    password-label=\"Je wachtwoord\"\n                    password-placeholder=\"Je wachtwoord\"\n                    remember-label=\"Blijf aangemeld\"\n                    login-button-text=\"Inloggen\"\n                    show-placeholders\n                    fail-redirect-link=\"/login?error=true\"\n                    success-redirect-link=\"/my-account\"\n                    ga-class=\"CustomerLoginEvent_Class\"\n                    email-invalid-label=\"Ongeldig e-mailadres ingevoerd\"\n                    email-valid-label=\"Geldig e-mailadres ingevoerd\"\n                    autocomplete=on\n                    tooltip-aria-label-open=\"form.component.toolt